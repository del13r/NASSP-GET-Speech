{
  "manifest_version": 3,
  "name": "NASSP GET Speech - Real-Time Sync",
  "version": "0.1.0",
  "description": "Keeps apolloinrealtime.org in step with the Ground Elapsed Time from NASSP GET Speech (Orbiter).",
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://apolloinrealtime.org/*", "https://www.apolloinrealtime.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
